---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { ArrowLeftIcon, SearchIcon } from "@lucide/astro";

import NotFoundImage from "../assets/not-found.svg";
import Button from "../components/Button.astro";
import { site, socials } from "../config/site";

const github = socials.find((s) => s.icon === "github")!;

Astro.locals.isNotFound = true;
---

<StarlightPage
	frontmatter={{
		title: "Page not found",
		template: "splash",
		pagefind: false,
		editUrl: false,
		prev: false,
		next: false,
	}}
>
	<div
		class="not-content flex flex-col items-center text-center gap-5 md:py-12"
	>
		<NotFoundImage
			class="w-full max-w-md h-auto md:mt-12"
			style="color: var(--sl-color-white)"
		/>
		<div class="mt-2 mb-4 flex flex-col items-center text-center">
			<p class="mb-1 font-mono text-sm text-subtle uppercase">
				Error 404
			</p>
			<h1
				class="mb-4 leading-none font-title font-medium text-ink dark:text-mist text-7xl"
			>
				Oops.
			</h1>
			<p class="max-w-xl text-xl text-muted">
				This page does not exist, or it was moved when the docs were
				rebuilt for v3. Try a search, or head back to the docs.
			</p>
			<a
				id="v2-hint"
				hidden
				href={site.v2Docs}
				class="mt-4 font-medium text-subtle underline underline-offset-4 decoration-2 hover:text-muted"
			>
				Were you looking for the v2 docs?
			</a>
		</div>
		<div class="flex flex-col items-center">
			<div class="mb-8 flex flex-col w-full md:flex-row gap-2">
				<Button
					label="Back to the docs"
					variant="primary"
					iconPlacement="start"
					href="/introduction/"
				>
					<ArrowLeftIcon slot="icon" />
				</Button>
				<Button
					id="search-docs"
					label="Search docs"
					variant="secondary"
					iconPlacement="start"
				>
					<SearchIcon slot="icon" />
				</Button>
			</div>
			<div>
				<p class="text-muted">
					<span>Followed a broken link?</span>{" "}
					<a
						class="font-medium text-muted hover:text-fg underline underline-offset-4 decoration-2 decoration-gray-300 dark:decoration-gray-700"
						href={github.href}
						>Let us know on GitHub.</a
					>
				</p>
			</div>
		</div>
	</div>
</StarlightPage>

<style is:global>
.content-panel:has(#_top) {
	padding: 0;
}
.content-panel + .content-panel {
	border-top: 0;
}
#_top {
	position: absolute;
	width: 1px;
	height: 1px;
	overflow: hidden;
	clip-path: inset(50%);
	white-space: nowrap;
}
</style>

<script>
const searchDocsBtn =
	document.querySelector<HTMLButtonElement>("#search-docs")!;
const siteSearchOpenBtn = document.querySelector<HTMLElement>(
	"site-search button[data-open-modal]",
);

searchDocsBtn.addEventListener("click", (e) => {
	if (!siteSearchOpenBtn) return;

	siteSearchOpenBtn.click();
	e.stopPropagation();
});

const hint = document.getElementById("v2-hint") as HTMLAnchorElement;
if (location.pathname.startsWith("/docs")) {
	hint.href = new URL(location.pathname.slice(1), hint.href).href;
	hint.hidden = false;
}
</script>
