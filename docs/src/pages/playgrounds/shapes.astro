---
import PlaygroundPage from "../../components/PlaygroundPage.astro";
import ShapesPlayground from "../../playground/shapes/ShapesPlayground.vue";
---

<PlaygroundPage playground="shapes">
	<ShapesPlayground client:only="vue">
		<div
			slot="fallback"
			class="grid grid-cols-1 md:grid-cols-[340px_minmax(0,1fr)] gap-y-4 gap-x-6"
		>
			<div class="h-130 rounded-2xl bg-surface animate-pulse"></div>
			<div class="h-120 rounded-2xl bg-surface animate-pulse"></div>
		</div>
	</ShapesPlayground>
</PlaygroundPage>
