---
import { Code } from "@astrojs/starlight/components";
import type { AstroComponent as AstroIconComponent } from "@lucide/astro";

import { demoCode } from "../../demos/regions";
import Switch from "../Switch.astro";
import DemoButton from "./DemoButton.astro";

interface Props {
	demo: string;
	size?: "full" | "compact" | "row";
	label?: string;
	icon?: AstroIconComponent;
}

const sources = import.meta.glob<string>("../../demos/*.demo.ts", {
	query: "?raw",
	import: "default",
	eager: true,
});

const { demo, size = "full", label = "Click me", icon } = Astro.props;
const source = sources[`../../demos/${demo}.demo.ts`];
if (source === undefined) throw new Error(`[LiveDemo] unknown demo "${demo}"`);

const code = demoCode(source);
const multiline = code?.includes("\n") ?? false;
---

<live-demo data-demo={demo} class="block bg-surface rounded-2xl not-content">
	{(size === "full" || size === "compact") && (
		<>
			<div
				class:list={[
					"relative grid place-items-center pointer-events-none *:pointer-events-auto",
					size === "full" && "h-60",
					size === "compact" && "h-40",
				]}
			>
				<div class:list={["absolute top-0 left-0 right-0 flex flex-row justify-between", size === "full" ? "m-5" : "m-4"]}>
					<p class="text-sm font-mono font-light tracking-wide uppercase text-subtle">
						Live Demo
					</p>
					<div class="text-sm hidden motion-reduce:flex flex-row gap-3 items-center">
						<span class="px-2.5 py-1 inline-flex flex-row gap-2 items-center bg-raised rounded-full">
							<span class="inline-block size-1.5 rounded-full bg-yellow-500"></span>
							<span class="font-mono text-xs tracking-wider">Reduced motion</span>
						</span>
					<Switch label="Play effects" data-play-effects />
				</div>
				</div>
				
				<DemoButton label={label} icon={icon} size={size} />
			</div>
			{code && !multiline && (
				<div class:list={["-mt-11 z-10 flex flex-row items-center", size === "full" ? "px-4 py-3" : "px-3 py-2.5"]}>
					<code class="text-muted text-sm">{code}</code>
				</div>
			)}
		</>
	)}
	{size === "row" && (
		<div class="px-5 py-4 flex flex-row items-center gap-4">
			{code && !multiline && <code class="text-muted text-sm">{code}</code>}
			<div class="ml-auto mr-0 shrink-0">
				<DemoButton label={label} icon={icon} size="compact" />
			</div>
		</div>
	)}
	{code && multiline && <Code code={code} lang="ts" />}
</live-demo>

<script>
import "../../scripts/motion";
import type { Demo } from "../../demos/types";

const modules = import.meta.glob<{ run: Demo }>("../../demos/*.demo.ts");

class LiveDemo extends HTMLElement {
	connectedCallback() {
		const ready = modules[`../../demos/${this.dataset.demo}.demo.ts`]();
		const button = this.querySelector("button")!;
		button.addEventListener("click", async (event) => {
			const { run } = await ready;
			run({ button, event });
		});
	}
}
customElements.define("live-demo", LiveDemo);
</script>
