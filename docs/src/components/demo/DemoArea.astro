---
import type { AstroComponent as AstroIconComponent } from "@lucide/astro";

interface Props {
	label: string;
	icon?: AstroIconComponent;
	size: "full" | "compact";
}

const { label, icon: Icon, size = "full" } = Astro.props;
const sizes = {
	full: ["px-6 py-2.5"],
	compact: ["px-6 py-2.5"],
};
---

<div
	class:list={[
        ...sizes[size],
        "flex flex-row items-center gap-2 cursor-pointer text-subtle",
        "border-2 border-field-line border-dashed rounded-2xl select-none"
    ]}
	data-demo-target
>
	{Icon && <Icon size={22} />}
	<span class="font-medium">{label}</span>
</div>
