---
import type { AstroComponent as AstroIconComponent } from "@lucide/astro";

interface Props {
	label: string;
	icon?: AstroIconComponent;
	size?: "large" | "compact";
}

const { label, icon: Icon, size = "large" } = Astro.props;
const sizes = {
	large: ["px-6 py-3"],
	compact: ["px-6 py-2"],
};
---

<div
	class:list={[
        ...sizes[size],
        "flex flex-row items-center gap-2 cursor-pointer text-subtle text-sm",
        "border-2 border-field-line border-dashed rounded-2xl select-none"
    ]}
	data-demo-target
>
	{Icon && <Icon size={22} />}
	<span class="font-medium">{label}</span>
</div>
