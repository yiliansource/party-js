---
import SidebarLink from "./SidebarLink.astro";
import SidebarSubgroup from "./SidebarSubgroup.astro";
import { isFunctionEntry, type SidebarEntry } from "./types";

interface Props {
	entries: SidebarEntry[];
	tree?: boolean;
}
const { entries, tree = false } = Astro.props;

const visible = entries.filter(
	(e) => e.type === "link" || e.entries.length > 0,
);

const startsTypes = (index: number) =>
	index > 0 &&
	isFunctionEntry(visible[index - 1]) &&
	!isFunctionEntry(visible[index]);
---

<ul
	class:list={[
		"flex list-none flex-col gap-px",
		tree
			? "mt-0.5 mb-1.5 ml-5 border-l border-line-strong pl-2.25"
			: "mt-0.5 pl-0",
	]}
>
	{visible.map((entry, index) => (
		<li class:list={[startsTypes(index) && "mt-3"]}>
			{entry.type === "link" ? (
				<SidebarLink link={entry} tree={tree} />
			) : (
				<SidebarSubgroup group={entry} />
			)}
		</li>
	))}
</ul>
