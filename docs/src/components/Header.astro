---
import Search from "@astrojs/starlight/components/Search.astro";

import { Image } from "astro:assets";

import lightImage from "../assets/lockup.svg";
import darkImage from "../assets/lockup-dark.svg";
import { headerLinks } from "../config/site";
import SocialIcons from "./SocialIcons.astro";
import ThemeToggle from "./ThemeToggle.astro";

const imageAttrs = {
	loading: "eager" as const,
	decoding: "async" as const,
	height: 32,
	alt: "party.js logo",
};

const { pathname } = Astro.url;
const notFound = Astro.locals.isNotFound === true;
---

<div class="h-full flex flex-row items-center justify-between">
	<!-- biome-ignore lint/a11y/useAnchorContent: alt text applied via attrs -->
	<a href="/" class="grid place-items-center">
		<Image src={darkImage} {...imageAttrs} class="light:sl-hidden" />
		<Image src={lightImage} {...imageAttrs} class="dark:sl-hidden" />
	</a>
	<div class="flex flex-row items-center">
		<div class="flex flex-row items-center gap-8">
			<div class="sl:w-64">
				<Search />
			</div>
			<div class="hidden sl:flex flex-row gap-8">
				{headerLinks.map((link) => (
					<a
						href={link.href}
						rel="me"
						class:list={["no-underline", !notFound && link.isActive(pathname) ? "font-bold text-fg" : "font-medium text-muted hover:text-fg"]}
					>
						{link.label}
					</a>
				))}
			</div>
		</div>
		<div class="hidden sl:block mx-6 h-6 border-r border-line"></div>
		<div class="hidden sl:flex flex-row items-center gap-8">
			<div class="flex flex-row gap-4">
				<SocialIcons />
			</div>
			<ThemeToggle />
		</div>
	</div>
</div>
