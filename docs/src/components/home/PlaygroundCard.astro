---
import { ArrowRightIcon } from "@lucide/astro";

interface Props {
	href: string;
}

const { href } = Astro.props;
---

<a
	href={href}
	class="group p-3 bg-surface hover:bg-raised transition-colors rounded-2xl text-inherit no-underline flex flex-col"
>
	<div class="mb-4">
		<slot name="miniature"></slot>
	</div>
	<div class="px-3 mb-2 flex flex-row items-center gap-10">
		<div>
			<h3 class="mb-1 text-fg text-xl">
				<slot name="title">Placeholder</slot>
			</h3>
			<p class="leading-normal text-[15px]">
				<slot name="description"></slot>
			</p>
		</div>
		<div class="grid place-items-center text-fg">
			<ArrowRightIcon
				size={22}
				class="ml-auto transition-transform group-hover:translate-x-1"
			/>
		</div>
	</div>
</a>
