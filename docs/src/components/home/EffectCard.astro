---
import ArrowLink from "./ArrowLink.astro";

interface Props {
	linkLabel?: string;
	linkHref?: string;
}

const { linkLabel, linkHref } = Astro.props;
---

<div class="flex flex-col">
	<div class="mb-5 p-5 h-54 bg-surface rounded-2xl">
		<slot></slot>
	</div>
	<h3 class="mb-1 text-fg text-xl">
		<slot name="title">Placeholder</slot>
	</h3>
	<p class="mb-2 leading-relaxed">
		<slot name="description"></slot>
	</p>
	{linkLabel && linkHref && <ArrowLink href={linkHref} label={linkLabel} />}
</div>
