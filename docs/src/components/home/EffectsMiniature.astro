---
import type { GlyphKey } from "../../brand/glyphs";
import Glyph from "../Glyph.astro";

interface Props {
	class?: string;
}

const bars = [
	{ label: "w-[46%]", from: 0, to: 38, hoverFrom: 0, hoverTo: 52 },
	{ label: "w-[30%]", from: 0, to: 62, hoverFrom: 0, hoverTo: 44 },
	{ label: "w-[40%]", from: 18, to: 52, hoverFrom: 10, hoverTo: 70 },
	{ label: "w-[52%]", from: 30, to: 58, hoverFrom: 22, hoverTo: 64 },
	{ label: "w-[34%]", from: 0, to: 46, hoverFrom: 0, hoverTo: 72 },
];

// [glyph, color, x%, y%, rotation in degrees, size]
type Piece = [GlyphKey, string, number, number, number, string];
const pieces: Piece[] = [
	["square", "text-coral", 28, 30, -18, "size-3"],
	["strip", "text-saffron", 38, 16, 20, "size-3.5"],
	["circle", "text-jade", 47, 34, 0, "size-2"],
	["star", "text-violet", 55, 12, 12, "size-3"],
	["square", "text-saffron", 64, 28, 32, "size-2.5"],
	["strip", "text-coral", 72, 42, -40, "size-3.5"],
	["circle", "text-violet", 34, 48, 0, "size-2"],
	["star", "text-coral", 44, 6, -8, "size-2.5"],
	["square", "text-jade", 58, 46, -26, "size-2.5"],
	["circle", "text-saffron", 68, 10, 0, "size-2"],
	["strip", "text-violet", 24, 14, 60, "size-3"],
	["square", "text-violet", 76, 22, 10, "size-2"],
	["circle", "text-coral", 52, 24, 0, "size-1.5"],
	["strip", "text-jade", 62, 4, -15, "size-3"],
];

const BUTTON = { x: 50, y: 66 };

const burst = pieces.map(([, , x, y, rotation], i) => ({
	"--r": `${rotation}deg`,
	"--rh": `${rotation + (i % 2 ? -1 : 1) * (90 + ((i * 37) % 120))}deg`,
	"--dx": `${((x - BUTTON.x) * 0.9).toFixed(1)}px`,
	"--dy": `${((y - BUTTON.y) * 0.4 - 4).toFixed(1)}px`,
	"--s": (1.15 + (i % 3) * 0.1).toFixed(2),
	"--d": `${Math.round(Math.hypot(x - BUTTON.x, y - BUTTON.y) * 3)}ms`,
}));
---

<div
	aria-hidden="true"
	class:list={["h-58 p-4 flex gap-4 rounded-2xl bg-page", Astro.props.class]}
>
	<div class="basis-[38%] shrink-0 flex flex-col gap-2.5">
		{bars.map((bar) => (
			<div class="flex flex-col gap-1.5">
				<span class:list={["h-1.5 rounded-full bg-line-strong", bar.label]} />
				<span class="relative h-4.5 rounded-md bg-field shadow-[inset_0_0_0_1px_var(--color-field-line)] overflow-hidden">
					<span
						class="absolute inset-y-0 bg-bar-fill left-(--from) right-(--right) group-hover:left-(--hover-from) group-hover:right-(--hover-right)
							not-motion-reduce:transition-[left,right] not-motion-reduce:duration-500 not-motion-reduce:ease-out"
						style={{
							"--from": `${bar.from}%`,
							"--right": `${100 - bar.to}%`,
							"--hover-from": `${bar.hoverFrom}%`,
							"--hover-right": `${100 - bar.hoverTo}%`,
						}}
					>
						{(bar.from > 0 || bar.hoverFrom > 0) && (
							<span class="absolute -left-px inset-y-1 w-0.5 rounded-full bg-bar-edge" />
						)}
						<span class="absolute -right-px inset-y-1 w-0.5 rounded-full bg-bar-edge" />
					</span>
				</span>
			</div>
		))}
	</div>
	<div class="relative flex-1 rounded-xl bg-surface overflow-hidden">
		{pieces.map(([glyph, color, x, y, , size], i) => (
			<Glyph
				key={glyph}
				class:list={[
					"absolute rotate-(--r)",
					"group-hover:rotate-(--rh) group-hover:translate-x-(--dx) group-hover:translate-y-(--dy) group-hover:scale-(--s)",
					"not-motion-reduce:transition-transform not-motion-reduce:duration-600 not-motion-reduce:delay-(--d) not-motion-reduce:ease-[cubic-bezier(0.34,1.56,0.64,1)]",
					size, color,
				]}
				style={{ left: `${x}%`, top: `${y}%`, ...burst[i] }}
			/>
		))}
		<span
			class="absolute left-1/2 top-[66%] -translate-1/2 w-16 h-7.5 rounded-lg shadow-[inset_0_0_0_1.5px_var(--color-line-strong)]
				group-hover:scale-92 group-hover:bg-line-strong/45 not-motion-reduce:transition-[scale,background-color] not-motion-reduce:duration-250"
		/>
	</div>
</div>
