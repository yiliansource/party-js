---
import type { GlyphKey } from "../../brand/glyphs";
import GlyphLabel from "../GlyphLabel.astro";

interface Props {
	glyph: GlyphKey;
	glyphColor: string;
	label: string;
	title: string;
	description?: string;
}

const { glyph, glyphColor, label, title, description } = Astro.props;
---

<section
	class="flex flex-col lg:flex-row gap-x-10 gap-y-6 justify-stretch not-content"
>
	<div class="flex-1 flex flex-col">
		<div class="mb-8 flex flex-col">
			<p
				class="mb-1 font-mono uppercase text-sm text-subtle tracking-wider"
			>
				<GlyphLabel glyph={glyph} color={glyphColor}>
					{label}
				</GlyphLabel>
			</p>
			<h2 class="my-0 text-[40px] leading-[1.2] font-bold text-fg">
				{title}
			</h2>
			{description && <p class="mt-2 max-w-2xl text-muted leading-relaxed text-lg">{description}</p>}
		</div>
		<slot></slot>
	</div>
	{Astro.slots.has("side") && <div class="grow flex-1 flex flex-col">
		<slot name="side"></slot>
	</div>}
</section>
