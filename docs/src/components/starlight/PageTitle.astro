---
import { kindLabel } from "../../config/reference";
import { sectionOf, sections } from "../../config/sections";
import Glyph from "../Glyph.astro";

const entry = Astro.locals.starlightRoute.entry;
const { title, description, reference } = entry.data;
const section = !Astro.locals.isNotFound ? sectionOf(entry.id) : null;
const sectionData = section !== null ? sections[section] : null;
const referenceGroup = reference !== undefined ? entry.id.split("/")[1] : null;
---

<div class="mt-4 flex flex-col">
	{sectionData !== null && (
	    <p class="mb-3 flex flex-row items-center gap-2">
	    	<Glyph
	    		key={sectionData.glyph}
	    		class="size-4"
	    		style={{ color: sectionData.accent }}
	    	/>
	    	<span class="inline-flex flex-row items-center gap-2.5 font-mono text-sm tracking-wider text-subtle uppercase">
	    		<span>{sectionData.label}</span>
	    		{reference && (
	    			<>
	    				<span aria-hidden="true">/</span>
	    				<span>{referenceGroup}</span>
	    				<span class="ml-1 px-3 py-1 -my-1 rounded-lg bg-surface text-muted">
	    					{kindLabel[reference.kind]}
	    				</span>
	    			</>
	    		)}
	    	</span>
	    </p>
    )}
	<h1
		id="_top"
		class:list={["text-fg text-5xl scroll-mt-[100vh]", reference && "font-mono"]}
	>
		{title}
	</h1>
	{description && <p class="mt-5 text-xl text-muted">{description}</p>}
</div>
