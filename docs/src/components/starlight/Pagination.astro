---
import PaginationCard from "../pagination/PaginationCard.astro";

const { pagination } = Astro.locals.starlightRoute;
const { prev, next } = pagination;
---

<div
	class="flex flex-col sm:flex-row justify-stretch gap-y-2 gap-x-4 w-full print:hidden"
>
	{prev && <PaginationCard link={prev} type="prev" />}
	{next && <PaginationCard link={next} type="next" />}
</div>
