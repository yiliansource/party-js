---
import { MoonIcon, SunIcon } from "@lucide/astro";
---

<theme-toggle>
	<button
		type="button"
		class="cursor-pointer bg-transparent leading-1 block text-muted hover:text-fg"
	>
		<MoonIcon class="dark:hidden" size={26} />
		<SunIcon class="not-dark:hidden" size={26} />
	</button>
</theme-toggle>

<script>
import { getTheme, storeTheme, type Theme } from "../../theme";

function onThemeChange(theme: Theme): void {
	document.documentElement.dataset.theme = theme;
	storeTheme(theme);
}

class ThemeToggle extends HTMLElement {
	connectedCallback() {
		this.querySelector("button")?.addEventListener("click", () => {
			onThemeChange(getTheme() === "dark" ? "light" : "dark");
		});
	}
}
customElements.define("theme-toggle", ThemeToggle);
</script>
