---
import { MoonIcon, SunIcon } from "@lucide/astro";
---

<theme-toggle>
	<button
		type="button"
		class="cursor-pointer bg-transparent leading-1 block text-muted hover:text-fg"
		aria-label="Dark mode"
	>
		<MoonIcon class="dark:hidden" size={26} />
		<SunIcon class="not-dark:hidden" size={26} />
	</button>
</theme-toggle>

<script>
import { applyTheme, getTheme } from "../../theme";

class ThemeToggle extends HTMLElement {
	connectedCallback() {
		const button = this.querySelector("button")!;
		button.setAttribute("aria-pressed", String(getTheme() === "dark"));
		button.addEventListener("click", () => {
			const newTheme = getTheme() === "dark" ? "light" : "dark";
			button.setAttribute("aria-pressed", String(newTheme === "dark"));
			applyTheme(newTheme);
		});
	}
}
customElements.define("theme-toggle", ThemeToggle);
</script>
