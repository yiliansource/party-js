---
import { type CollectionEntry, getCollection } from "astro:content";

import { isPublished } from "../../utils/drafts";
import EntryCard from "../EntryCard.astro";
import CompactFooter from "../footer/CompactFooter.astro";
import LargeFooter from "../footer/LargeFooter.astro";
import PageMeta from "../footer/PageMeta.astro";
import Pagination from "./Pagination.astro";

const { entry } = Astro.locals.starlightRoute;
const { reference } = entry.data;
const guides = reference
	? await getCollection(
			"docs",
			(entry: CollectionEntry<"docs">) =>
				isPublished(entry) && entry.data.api?.includes(reference.name),
		)
	: [];

const isHomepage = entry.id === "";
---

{isHomepage ? (
	<LargeFooter />
) : (
	<footer class="flex flex-col grow mt-12">
		{guides.length > 0 && (
			<div class="mb-8 flex flex-col">
				{guides.map((guide) => (
					<EntryCard entry={guide} />
				))}
			</div>
		)}
		<PageMeta />
		<Pagination />
		<CompactFooter />
	</footer>
)}
