---
import type { HTMLAttributes } from "astro/types";

import { type ButtonSize, type ButtonVariant, buttonClass } from "./button";

type Props = {
	label: string;
	variant?: ButtonVariant;
	size?: ButtonSize;
	iconPlacement?: "start" | "end";
	href?: string;
	class?: string;
} & Omit<HTMLAttributes<"button">, "class"> &
	Omit<HTMLAttributes<"a">, "class" | "type">;

const {
	label,
	variant = "primary",
	size = "md",
	iconPlacement = "end",
	href,
	class: className,
	...rest
} = Astro.props;

const Tag = href ? "a" : "button";
const hasIcon = Astro.slots.has("icon");
---

<Tag
	{...rest}
	href={href}
	type={href ? undefined : (rest.type ?? "button")}
	class:list={[buttonClass(variant, size), className]}
>
	{hasIcon && iconPlacement === "start" && <slot name="icon" />}
	<span>{label}</span>
	{hasIcon && iconPlacement === "end" && <slot name="icon" />}
</Tag>
