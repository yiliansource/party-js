---
import type { SimpleIcon } from "simple-icons";

interface Props {
	icon: SimpleIcon;
	size?: number;
	label?: string;
}

const { icon, size = 20, label } = Astro.props;
---

<svg
	viewBox="0 0 24 24"
	width={size}
	height={size}
	fill="currentColor"
	role={label ? "img" : undefined}
	aria-label={label}
	aria-hidden={label ? undefined : "true"}
>
	<path d={icon.path} />
</svg>
