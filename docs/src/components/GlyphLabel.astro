---
import type { GlyphKey } from "../brand/glyphs";
import { type SectionKey, sections } from "../config/sections";
import Glyph from "./Glyph.astro";

type Props =
	| { section: SectionKey; class?: string; glyphClass?: string }
	| { glyph: GlyphKey; color: string; class?: string; glyphClass?: string };

const props = Astro.props;
const { glyph, accent, label } =
	"section" in props
		? sections[props.section]
		: { glyph: props.glyph, accent: props.color, label: undefined };
---

<span class:list={["inline-flex items-center gap-2", props.class]}>
	<Glyph
		key={glyph}
		class:list={["shrink-0", props.glyphClass ?? "size-4"]}
		style={{ color: accent }}
	/>
	<slot>
		{label && <span class="whitespace-nowrap">{label}</span>}
	</slot>
</span>
