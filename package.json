{
	"name": "party-js",
	"version": "3.0.0",
	"author": "Ian Hornik",
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"bundle"
	],
	"homepage": "https://party.js.org",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yiliansource/party-js.git"
	},
	"bugs": {
		"url": "https://github.com/yiliansource/party-js/issues"
	},
	"keywords": [
		"party",
		"confetti",
		"particles"
	],
	"scripts": {
		"build": "tsup",
		"test": "bun test tests/*",
		"typecheck": "tsc -b --noEmit",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"size": "bun run scripts/check-size.ts",
		"api": "bun run scripts/check-api.ts",
		"record:demos": "bun run scripts/record-demos.ts",
		"prepare": "lefthook install",
		"prepublishOnly": "bun run build && bun run size && bun run api"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.4",
		"@napi-rs/canvas": "^1.1.0",
		"@types/bun": "^1.4.4",
		"lefthook": "^2.2.2",
		"playwright": "1.65.0",
		"tsup": "^9.0.0",
		"typescript": "~6.0.3"
	}
}
