{
	"name": "party-js",
	"version": "3.0.0",
	"author": "Ian Hornik",
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"bundle"
	],
	"homepage": "https://party.js.org",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yiliansource/party-js.git"
	},
	"bugs": {
		"url": "https://github.com/yiliansource/party-js/issues"
	},
	"keywords": [
		"party",
		"confetti",
		"particles"
	],
	"scripts": {
		"build": "tsup",
		"test": "bun test tests/*",
		"typecheck": "tsc -b --noEmit",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"prepare": "lefthook install"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@napi-rs/canvas": "^1.0.9",
		"@types/bun": "^1.4.2",
		"@types/culori": "^4.0.1",
		"lefthook": "^2.1.14",
		"tsup": "^8.5.1",
		"typescript": "~6.0.3"
	},
	"dependencies": {
		"culori": "^4.0.2"
	}
}
